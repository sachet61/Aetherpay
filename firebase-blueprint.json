{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control, security badges, and balance references",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["customer", "agent", "admin"] },
        "avatarUrl": { "type": "string" },
        "phone": { "type": "string" },
        "isPhoneVerified": { "type": "boolean" },
        "isEmailVerified": { "type": "boolean" },
        "isKycVerified": { "type": "boolean" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "totalReferred": { "type": "number" },
        "totalBonusEarned": { "type": "number" },
        "assignedAgentId": { "type": "string" },
        "onlineStatus": { "type": "string", "enum": ["online", "idle", "offline"] },
        "lastSeenAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role", "createdAt"]
    },
    "userWallet": {
      "title": "UserWallet",
      "description": "Financial ledger wallet for playable and bonus gaming funds",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "realBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "pendingBalance": { "type": "number" },
        "totalDeposited": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "currency": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "realBalance", "bonusBalance", "currency", "updatedAt"]
    },
    "walletTransaction": {
      "title": "WalletTransaction",
      "description": "Immutable ledger record of debits, credits, bonus grants, and settlements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["topup", "withdrawal", "game_transfer", "game_load", "game_redeem", "bonus", "referral_payout"] },
        "amount": { "type": "number" },
        "bonusAmount": { "type": "number" },
        "fee": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed", "cancelled"] },
        "description": { "type": "string" },
        "referenceId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "gamePlatform": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "status", "createdAt"]
    },
    "topUpRequest": {
      "title": "TopUpRequest",
      "description": "Inbound deposit request pending payment receipt proof or automated gateway clearance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "bonusPercentage": { "type": "number" },
        "bonusAmount": { "type": "number" },
        "finalCredits": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "referenceCode": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "under_review", "approved", "rejected"] },
        "reviewedBy": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "paymentMethod", "referenceCode", "status", "createdAt"]
    },
    "withdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "Outbound payout request with compliance checks and cashout receipt tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "fee": { "type": "number" },
        "netAmount": { "type": "number" },
        "payoutMethod": { "type": "string" },
        "payoutDetails": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "approved", "completed", "rejected"] },
        "processedBy": { "type": "string" },
        "proofUrl": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "payoutMethod", "payoutDetails", "status", "createdAt"]
    },
    "gameCatalogItem": {
      "title": "GameCatalogItem",
      "description": "Available fish games, slots, and interactive gaming engines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "playUrl": { "type": "string" },
        "minLoad": { "type": "number" },
        "maxLoad": { "type": "number" },
        "jackpot": { "type": "number" },
        "isActive": { "type": "boolean" },
        "popularity": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "category", "isActive"]
    },
    "gameAccount": {
      "title": "GameAccount",
      "description": "Customer credentials and game credentials bound to a specific game platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "gameId": { "type": "string" },
        "gameName": { "type": "string" },
        "gameUsername": { "type": "string" },
        "gamePassword": { "type": "string" },
        "currentBalance": { "type": "number" },
        "lastSyncedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "gameId", "gameUsername"]
    },
    "supportConversation": {
      "title": "SupportConversation",
      "description": "Direct support conversation channel between player and agent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "agentId": { "type": "string" },
        "agentName": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "pending", "resolved", "closed"] },
        "lastMessage": { "type": "string" },
        "lastMessageTimestamp": { "type": "string" },
        "unreadCountCustomer": { "type": "number" },
        "unreadCountAgent": { "type": "number" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "category": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId", "status", "createdAt"]
    },
    "chatMessage": {
      "title": "ChatMessage",
      "description": "Real-time message including action cards for topups, games, or cashouts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["customer", "agent", "system"] },
        "senderName": { "type": "string" },
        "text": { "type": "string", "maxLength": 5000 },
        "timestamp": { "type": "string" },
        "imageUrl": { "type": "string" },
        "actionType": { "type": "string" },
        "actionData": { "type": "object" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "conversationId", "senderId", "senderRole", "timestamp"]
    },
    "appNotification": {
      "title": "AppNotification",
      "description": "In-app alert notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "promo"] },
        "link": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type", "createdAt"]
    },
    "appConfig": {
      "title": "AppConfig",
      "description": "Platform settings, deposit limits, promotions, and feature flags",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appName": { "type": "string" },
        "welcomeBonusPercentage": { "type": "number" },
        "dailyBonusAmount": { "type": "number" },
        "minTopUp": { "type": "number" },
        "maxTopUp": { "type": "number" },
        "minWithdrawal": { "type": "number" },
        "maxWithdrawal": { "type": "number" },
        "withdrawalFeePercentage": { "type": "number" },
        "maintenanceMode": { "type": "boolean" },
        "allowedPaymentMethods": { "type": "array" },
        "allowedPayoutMethods": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "appName", "minTopUp", "minWithdrawal"]
    },
    "auditLog": {
      "title": "AuditLog",
      "description": "Administrative actions and security trace records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "actorId", "action", "timestamp"]
    },
    "webhookLog": {
      "title": "WebhookLog",
      "description": "Incoming payment provider and gaming platform webhooks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "provider": { "type": "string" },
        "event": { "type": "string" },
        "payload": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "provider", "event", "timestamp"]
    },
    "cashoutFeedItem": {
      "title": "CashoutFeedItem",
      "description": "Public ticker feed of verified player cashouts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "game": { "type": "string" },
        "timeAgo": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userName", "amount", "game"]
    },
    "passwordResetToken": {
      "title": "PasswordResetToken",
      "description": "Secure, time-limited token for self-service password recovery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "token": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "used": { "type": "boolean" },
        "usedAt": { "type": "number" }
      },
      "required": ["id", "token", "email", "createdAt", "expiresAt", "used"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User accounts and authentication identity mappings"
    },
    "/wallets/{walletId}": {
      "schema": "userWallet",
      "description": "Financial ledger wallets linked to individual users"
    },
    "/transactions/{transactionId}": {
      "schema": "walletTransaction",
      "description": "Ledger records of money movement, topups, and game loads"
    },
    "/topups/{topUpId}": {
      "schema": "topUpRequest",
      "description": "Inbound deposit requests and payment receipt submissions"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "withdrawalRequest",
      "description": "Cashout requests with payout status and proof links"
    },
    "/game_catalog/{catalogId}": {
      "schema": "gameCatalogItem",
      "description": "Catalog of playable games and platform links"
    },
    "/game_accounts/{accountId}": {
      "schema": "gameAccount",
      "description": "Credentials and balances for connected gaming platforms"
    },
    "/conversations/{conversationId}": {
      "schema": "supportConversation",
      "description": "Real-time support channel records"
    },
    "/messages/{messageId}": {
      "schema": "chatMessage",
      "description": "Real-time chat messages and transaction interactive cards"
    },
    "/notifications/{notificationId}": {
      "schema": "appNotification",
      "description": "User-targeted alert notifications"
    },
    "/audit_logs/{logId}": {
      "schema": "auditLog",
      "description": "Administrative actions audit trail"
    },
    "/config/{configId}": {
      "schema": "appConfig",
      "description": "Platform global configuration and payout settings"
    },
    "/webhook_logs/{logId}": {
      "schema": "webhookLog",
      "description": "External webhook event logs"
    },
    "/faked_cashouts/{cashoutId}": {
      "schema": "cashoutFeedItem",
      "description": "Live ticker feed entries for completed player wins"
    },
    "/password_reset_tokens/{tokenId}": {
      "schema": "passwordResetToken",
      "description": "Verification tokens for self-service password reset"
    }
  }
}
