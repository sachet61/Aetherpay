rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['sachet61@gmail.com', 'admin@aetherpay.com', 'blithesweeps@gmail.com', 'support@aetherpay.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isAgentOrAdmin() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['agent', 'admin'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAgentOrAdmin() || !exists(/databases/$(database)/documents/users/$(userId));
    }

    // Wallets collection
    match /wallets/{walletId} {
      allow read: if true;
      allow write: if isSignedIn() || !exists(/databases/$(database)/documents/wallets/$(walletId));
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Top-ups collection
    match /topups/{topUpId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Withdrawals collection
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Game catalog collection - public read for games showcase, management for admins
    match /game_catalog/{catalogId} {
      allow read, write: if true;
    }

    // Game accounts collection
    match /game_accounts/{accountId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Audit logs collection
    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Config collection - public read and admin write for platform settings and QR codes
    match /config/{configId} {
      allow read, write: if true;
    }

    // Webhook logs
    match /webhook_logs/{logId} {
      allow read, write: if true;
    }

    // Cashouts live feed - public ticker read
    match /faked_cashouts/{cashoutId} {
      allow read: if true;
      allow write: if true;
    }

    // Password reset tokens collection - secure self-service password reset
    match /password_reset_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
